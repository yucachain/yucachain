{
  "name": "yucachain",
  "private": true,
  "version": "0.1.0",
  "description": "Yucachain — agricultural marketplace for Ogun State",
  "scripts": {
    "dev": "pnpm --filter @yucachain/shared build && pnpm --parallel --filter @yucachain/web --filter @yucachain/api dev",
    "dev:web": "pnpm --filter @yucachain/web dev",
    "dev:api": "pnpm --filter @yucachain/shared build && pnpm --filter @yucachain/api dev",
    "build": "pnpm --filter @yucachain/shared build && pnpm --filter @yucachain/api build && pnpm --filter @yucachain/web build",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma generate && prisma db push && tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.6.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.10",
    "bcryptjs": "^2.4.3",
    "prisma": "^6.6.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=20"
  }
}
